{
  // Őrtorony — Worker + statikus fájlok. A "name" PONTOSAN a meglévő Worker neve legyen
  // (a Cloudflare dashboardon a fülek fölött, a projekt címe), különben új Workert hoz létre.
  "name": "ortorony",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GH_REPO": "bardoczikornel-svg/ortorony",
    "GH_BRANCH": "main"
  }
  // GH_TOKEN: NEM ide — a dashboardon Secret típussal, az megmarad deployok között.
}
